{
  "name": "worlds-apart",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "test:tools": "node --test scripts/test-chatgpt-tools.mjs",
    "test:browser": "node tests/browser-smoke.mjs",
    "context:export": "node scripts/export-chatgpt-context.mjs",
    "change:check": "node scripts/apply-chatgpt-change.mjs",
    "change:apply": "node scripts/apply-chatgpt-change.mjs",
    "check": "npm test && npm run test:tools && npm run build && npm run test:browser"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "playwright": "^1.62.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  }
}
